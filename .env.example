# Copy to .env and fill in your own values. .env is gitignored — never commit real secrets.

# --- Database (PostgreSQL) ---
# Point this at your Postgres. From Docker containers (macOS/Windows) the host is
# reachable via host.docker.internal.
POSTGRES_USER=negotiai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=negotiai
DATABASE_URL=postgres://negotiai:changeme@host.docker.internal:5432/negotiai?sslmode=disable

# --- Service ports (host side) ---
FRONTEND_PORT=3200
BACKEND_PORT=8090
AGENT_PORT=8000

# --- LLM via AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-3
# Examples: apac.anthropic.claude-sonnet-4-20250514-v1:0  |  moonshotai.kimi-k2.5
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
# Agent brain: "bedrock" (real LLM, needs creds) or "mock" (deterministic, no creds)
NEGOTIAI_BRAIN=bedrock

# --- Service URLs (internal; on Railway use http://<service>.railway.internal:<port>) ---
AGENT_SERVICE_URL=http://agent:8000
BACKEND_INTERNAL_URL=http://backend:8080

# --- CORS: frontend public origins, comma-separated (browser -> backend) ---
ALLOWED_ORIGINS=http://localhost:3200

# --- Frontend (build-time; inlined into the browser bundle) ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8090
